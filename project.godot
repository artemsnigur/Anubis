[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="hurtbox"
3d_physics/layer_5="interact"
3d_physics/layer_6="gate"
3d_physics/layer_7="trigger"
3d_physics/layer_8="pickup"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.08, 1)

[shader_globals]

player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
occlusion_radius={
"type": "float",
"value": 0.16
}
occlusion_enabled={
"type": "float",
"value": 1.0
}
